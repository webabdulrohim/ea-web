generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://neondb_owner:npg_NEzZX8PdYyA3@ep-super-night-aqt5chn8.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  role          String    @default("STUDENT_PARENT")
  phoneNumber   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tutorSkills   TutorSkill[]
  availabilities Availability[]
  tutorBookings ClassBooking[] @relation("TutorBookings")
  students      Student[]
}

model Program {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?     @db.Text
  price       Float
  skills      TutorSkill[]
  bookings    ClassBooking[]
}

model Student {
  id            String    @id @default(cuid())
  name          String
  dateOfBirth   DateTime
  parentId      String
  parent        User      @relation(fields: [parentId], references: [id])
  bookings      ClassBooking[]
  grade         String?
  school        String?
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model TutorSkill {
  id        String  @id @default(cuid())
  tutorId   String
  tutor     User    @relation(fields: [tutorId], references: [id])
  programId String
  program   Program @relation(fields: [programId], references: [id])

  @@unique([tutorId, programId])
}

model Availability {
  id        String   @id @default(cuid())
  tutorId   String
  tutor     User     @relation(fields: [tutorId], references: [id])
  dayOfWeek Int
  startTime String
  endTime   String
  
  @@unique([tutorId, dayOfWeek, startTime, endTime])
}

model ClassBooking {
  id               String   @id @default(cuid())
  tutorId          String
  tutor            User     @relation("TutorBookings", fields: [tutorId], references: [id])
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id])
  programId        String
  program          Program  @relation(fields: [programId], references: [id])
  date             DateTime
  startTime        DateTime
  endTime          DateTime
  status           String   @default("SCHEDULED")
  attendance       Boolean? 
  attendanceStatus String?  @default("SCHEDULED") 
  notes            String?  @db.Text
  report           String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Invoice {
  id          String   @id @default(cuid())
  parentId    String
  amount      Float
  dueDate     DateTime
  status      String   @default("UNPAID")
  proofImage  String?  @db.Text
  description String?  @db.Text
  items       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Transaction {
  id          String   @id @default(cuid())
  type        String   
  category    String   
  amount      Float
  date        DateTime @default(now())
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- CMS & Content Models ---

model LandingContent {
  id            String   @id @default("singleton")
  logoUrl       String?  @db.Text
  heroTitle     String   @default("EA - English Action")
  heroDesc      String   @default("Be Brave to Act") @db.Text
  heroImageUrl  String?  @db.Text
  ownerName     String   @default("Owner EA")
  ownerMsg      String   @default("Selamat datang...") @db.Text
  ownerImageUrl String?  @db.Text
  videoUrl      String?  @db.Text
  updatedAt     DateTime @updatedAt
}

model Location {
  id        String   @id @default(cuid())
  name      String   
  address   String   @db.Text
  mapsUrl   String   @db.Text
  createdAt DateTime @default(now())
}

model GalleryItem {
  id        String   @id @default(cuid())
  type      String   @default("IMAGE") 
  url       String   @db.Text
  title     String?
  createdAt DateTime @default(now())
}

model Post {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String   @db.Text
  image     String?  @db.Text
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
