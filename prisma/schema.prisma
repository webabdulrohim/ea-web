generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://neondb_owner:npg_NEzZX8PdYyA3@ep-super-night-aqt5chn8.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require"
}

model User {
  id             String         @id @default(cuid())
  name           String?
  email          String         @unique
  password       String
  role           String         @default("STUDENT_PARENT")
  phoneNumber    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  availabilities Availability[]
  tutorBookings  ClassBooking[] @relation("TutorBookings")
  students       Student[]
  tutorSkills    TutorSkill[]
}

model Program {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  price       Float
  bookings    ClassBooking[]
  skills      TutorSkill[]
}

model Student {
  id          String         @id @default(cuid())
  name        String
  dateOfBirth DateTime
  parentId    String
  grade       String?
  school      String?
  status      String         @default("ACTIVE")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  bookings    ClassBooking[]
  parent      User           @relation(fields: [parentId], references: [id])
}

model TutorSkill {
  id        String  @id @default(cuid())
  tutorId   String
  programId String
  program   Program @relation(fields: [programId], references: [id])
  tutor     User    @relation(fields: [tutorId], references: [id])

  @@unique([tutorId, programId])
}

model Availability {
  id        String @id @default(cuid())
  tutorId   String
  dayOfWeek Int
  startTime String
  endTime   String
  tutor     User   @relation(fields: [tutorId], references: [id])

  @@unique([tutorId, dayOfWeek, startTime, endTime])
}

model ClassBooking {
  id               String   @id @default(cuid())
  tutorId          String
  studentId        String
  programId        String
  date             DateTime
  startTime        DateTime
  endTime          DateTime
  status           String   @default("SCHEDULED")
  attendance       Boolean?
  attendanceStatus String?  @default("SCHEDULED")
  notes            String?
  report           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  program          Program  @relation(fields: [programId], references: [id])
  student          Student  @relation(fields: [studentId], references: [id])
  tutor            User     @relation("TutorBookings", fields: [tutorId], references: [id])
}

model Invoice {
  id          String   @id @default(cuid())
  parentId    String
  amount      Float
  dueDate     DateTime
  status      String   @default("UNPAID")
  proofImage  String?
  description String?
  items       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Transaction {
  id          String   @id @default(cuid())
  type        String
  category    String
  amount      Float
  date        DateTime @default(now())
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LandingContent {
  id            String   @id @default("singleton")
  logoUrl       String?
  heroTitle     String   @default("EA - English Action")
  heroDesc      String   @default("Be Brave to Act")
  heroImageUrl  String?
  ownerName     String   @default("Owner EA")
  ownerMsg      String   @default("Selamat datang...")
  ownerImageUrl String?
  videoUrl      String?
  updatedAt     DateTime @updatedAt
}

model Location {
  id        String   @id @default(cuid())
  name      String
  address   String
  mapsUrl   String
  createdAt DateTime @default(now())
}

model GalleryItem {
  id        String   @id @default(cuid())
  type      String   @default("IMAGE")
  url       String
  title     String?
  createdAt DateTime @default(now())
}

model Post {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  image     String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
